---
import Layout from '../layouts/Layout.astro';
import { defaultLang, langs, localizePath, t } from '../i18n';

// The 404 page is built once, so it cannot know the language of the broken URL.
// It speaks the main language and offers the other two below.
const lang = defaultLang;
const text = t(lang).notFound;
const others = langs.filter((l) => l !== lang);
---

<Layout lang={lang} title={text.title} alternates={false}>
  <section class="mx-auto max-w-2xl px-4 py-24 text-center">
    <p class="font-serif text-7xl text-accent-dark">404</p>
    <h1 class="mt-4 font-serif text-4xl">{text.title}</h1>
    <p class="mt-4 text-muted">{text.text}</p>
    <a
      href={localizePath(lang, '/')}
      class="mt-8 inline-block bg-ink px-7 py-3 text-xs tracking-[0.2em] text-paper uppercase hover:bg-accent-dark"
    >
      {t(lang).notFound.home}
    </a>
    <ul class="mt-12 space-y-1 text-sm text-muted">
      {others.map((l) => (
        <li lang={l}>
          {t(l).notFound.title} ·{' '}
          <a href={localizePath(l, '/')} class="underline hover:text-ink">
            {t(l).notFound.home}
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
