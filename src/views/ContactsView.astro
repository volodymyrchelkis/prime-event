---
import Layout from '../layouts/Layout.astro';
import LeadForm from '../components/LeadForm.astro';
import { site } from '../data/site';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const text = t(lang);

const channels = [
  { label: text.contacts.phone, value: site.phoneDisplay, href: `tel:${site.phone}` },
  { label: 'Telegram', value: text.contacts.writeTelegram, href: site.telegram },
  { label: 'Instagram', value: site.instagramHandle, href: site.instagram },
];
---

<Layout lang={lang} title={text.contacts.title}>
  <section class="mx-auto max-w-4xl px-4 py-14 text-center">
    <h1 class="font-serif text-5xl">{text.contacts.title}</h1>
    <p class="mx-auto mt-4 max-w-xl text-muted">{text.contacts.intro}</p>

    <div class="mt-12 grid gap-4 sm:grid-cols-3">
      {channels.map((c) => (
        <a
          href={c.href}
          target={c.href.startsWith('http') ? '_blank' : undefined}
          rel="noopener"
          class="border border-line bg-white/60 px-6 py-8 transition-colors hover:border-accent"
        >
          <span class="block text-xs tracking-[0.3em] text-accent uppercase">{c.label}</span>
          <span class="mt-3 block font-serif text-xl">{c.value}</span>
        </a>
      ))}
    </div>

    <LeadForm lang={lang} />

    <p class="mt-12 text-sm tracking-[0.2em] text-muted uppercase">{text.city}</p>
  </section>
</Layout>
