---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import BusinessSchema from '../components/BusinessSchema.astro';
import { services } from '../data/services';
import { localizePath, t, type Lang } from '../i18n';
import heroCharacters from '../assets/home/hero-characters.jpg';
import heroConfetti from '../assets/home/hero-confetti.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const text = t(lang);
---

<Layout lang={lang}>
  <BusinessSchema lang={lang} />
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 md:grid-cols-2 md:py-20">
    <div class="text-center md:text-left">
      <p class="text-xs tracking-[0.3em] text-accent uppercase">{text.city}</p>
      <h1 class="mt-4 font-serif text-4xl leading-tight sm:text-5xl md:text-6xl">
        {text.home.title}
      </h1>
      <p class="mt-6 text-muted">{text.description}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3 md:justify-start">
        <a
          href={localizePath(lang, '/contacts')}
          class="bg-ink px-7 py-3 text-xs tracking-[0.2em] text-paper uppercase hover:bg-accent-dark"
        >
          {text.home.book}
        </a>
        <a
          href={localizePath(lang, '/characters')}
          class="border border-ink px-7 py-3 text-xs tracking-[0.2em] uppercase hover:bg-ink hover:text-paper"
        >
          {text.home.characters}
        </a>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-3">
      <Photo
        label={text.home.heroPhotos[0]}
        ratio="3 / 4"
        image={heroConfetti}
        priority
        sizes="(min-width: 768px) 280px, 50vw"
      />
      <div class="mt-10">
        <Photo
          label={text.home.heroPhotos[1]}
          ratio="3 / 4"
          image={heroCharacters}
          priority
          sizes="(min-width: 768px) 280px, 50vw"
        />
      </div>
    </div>
  </section>

  <section class="border-t border-line">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="text-center font-serif text-4xl">{text.home.whatWeDo}</h2>
      <div class="mt-10 grid gap-8 sm:grid-cols-2">
        {services
          .filter((s) => s.onHome !== false)
          .map((s, i) => (
            <article>
              <Photo
                ratio="4 / 3"
                tone={i}
                label={s.photo?.alt[lang] ?? s.title[lang]}
                image={s.photo?.image}
                position={s.photo?.position}
              />
              <h3 class="mt-4 font-serif text-2xl">{s.title[lang]}</h3>
            </article>
          ))}
      </div>
    </div>
  </section>
</Layout>
