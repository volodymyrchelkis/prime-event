---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import { characters } from '../data/characters';
import { packages } from '../data/packages';
import { site } from '../data/site';
import { services } from '../data/services';
import { localizePath, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const text = t(lang);
const contacts = localizePath(lang, '/contacts');
const sectionTitle = 'text-center font-serif text-4xl';
const outlineButton =
  'inline-block border border-ink px-7 py-3 text-xs tracking-[0.2em] uppercase hover:bg-ink hover:text-paper';
---

<Layout lang={lang}>
  <section class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-14 md:grid-cols-2 md:py-20">
    <div class="text-center md:text-left">
      <p class="text-xs tracking-[0.3em] text-accent uppercase">{text.city}</p>
      <h1 class="mt-4 font-serif text-4xl leading-tight sm:text-5xl md:text-6xl">
        {text.home.title}
      </h1>
      <p class="mt-6 text-muted">{text.description}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3 md:justify-start">
        <a
          href={contacts}
          class="bg-ink px-7 py-3 text-xs tracking-[0.2em] text-paper uppercase hover:bg-accent-dark"
        >
          {text.home.book}
        </a>
        <a href={localizePath(lang, '/characters')} class={outlineButton}>
          {text.home.characters}
        </a>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-3">
      <Photo label={site.name} ratio="3 / 4" tone={0} />
      <div class="mt-10">
        <Photo label={site.name} ratio="3 / 4" tone={2} />
      </div>
    </div>
  </section>

  {site.newYearSeason && (
    <section id="new-year" class="bg-ink text-paper">
      <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 md:grid-cols-2">
        <Photo label={text.home.newYear.title} ratio="4 / 3" tone={2} />
        <div class="text-center md:text-left">
          <p class="text-xs tracking-[0.3em] uppercase opacity-80">🎄 {text.home.newYear.badge}</p>
          <h2 class="mt-3 font-serif text-4xl">{text.home.newYear.title}</h2>
          <p class="mt-5 opacity-90">{text.home.newYear.text}</p>
          <p class="mt-3 text-sm opacity-80">{text.home.newYear.note}</p>
          <a
            href={contacts}
            class="mt-8 inline-block bg-paper px-7 py-3 text-xs tracking-[0.2em] text-ink uppercase hover:bg-line"
          >
            {text.home.newYear.cta}
          </a>
        </div>
      </div>
    </section>
  )}

  <section id="programs" class="border-b border-line">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class={sectionTitle}>{text.home.programsTitle}</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {packages.map((p) => (
          <a
            href={`${contacts}?package=${p.id}#lead-form`}
            class="group border border-line bg-white/60 p-8 text-center transition-colors hover:border-accent"
          >
            <h3 class="font-serif text-2xl">{p.name[lang]}</h3>
            <p class="mt-2 font-serif text-4xl text-accent-dark">{p.priceEur} €</p>
            <p class="mt-3 text-xs tracking-[0.2em] text-muted uppercase">
              {p.characters[lang]} · {p.duration[lang]}
            </p>
          </a>
        ))}
      </div>
      <p class="mt-10 text-center">
        <a href={localizePath(lang, '/services')} class={outlineButton}>
          {text.home.programsCta}
        </a>
      </p>
    </div>
  </section>

  <section id="steps">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class={sectionTitle}>{text.home.stepsTitle}</h2>
      <ol class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {text.home.steps.map((step, i) => (
          <li class="text-center">
            <span class="mx-auto flex size-12 items-center justify-center rounded-full border border-accent font-serif text-xl text-accent-dark">
              {i + 1}
            </span>
            <h3 class="mt-4 font-serif text-2xl">{step.title}</h3>
            <p class="mt-2 text-sm text-muted">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="home-characters" class="border-t border-line">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class={sectionTitle}>{text.characters.title}</h2>
      <div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-4">
        {characters.slice(0, 4).map((c, i) => (
          <figure>
            <Photo tone={i} label={c.name} />
            <figcaption class="mt-3 font-serif text-xl">{c.name}</figcaption>
          </figure>
        ))}
      </div>
      <p class="mt-10 text-center">
        <a href={localizePath(lang, '/characters')} class={outlineButton}>
          {text.home.charactersCta}
        </a>
      </p>
    </div>
  </section>

  <section class="border-t border-line">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class={sectionTitle}>{text.home.whatWeDo}</h2>
      <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {services.slice(0, 3).map((s, i) => (
          <a href={localizePath(lang, '/services')} class="group block">
            <Photo ratio="4 / 3" tone={i} label={s.title[lang]} />
            <h3 class="mt-4 font-serif text-2xl group-hover:text-accent-dark">{s.title[lang]}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="cta" class="border-t border-line bg-white/60">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center">
      <h2 class="font-serif text-4xl">{text.home.ctaTitle}</h2>
      <p class="mt-4 text-muted">{text.home.ctaText}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a
          href={contacts}
          class="bg-ink px-7 py-3 text-xs tracking-[0.2em] text-paper uppercase hover:bg-accent-dark"
        >
          {text.home.book}
        </a>
        <a href={site.telegram} target="_blank" rel="noopener" class={outlineButton}>
          {text.contacts.writeTelegram}
        </a>
      </div>
    </div>
  </section>
</Layout>
