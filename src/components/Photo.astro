---
// Заглушка вместо фото, пока нет настоящих снимков.
interface Props {
  label: string;
  ratio?: string;
  tone?: number;
}

const { label, ratio = '4 / 5', tone = 0 } = Astro.props;
const tones = [
  'from-[#efe3d6] to-[#dcc6b2]',
  'from-[#e7e4dc] to-[#cfc8b8]',
  'from-[#f1e0dc] to-[#dbbfb7]',
];
---

<div
  class={`bg-gradient-to-br ${tones[tone % tones.length]}`}
  style={`aspect-ratio: ${ratio}`}
  role="img"
  aria-label={label}
></div>
