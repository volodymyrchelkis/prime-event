---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// A real photo when `image` is given, otherwise a placeholder until the owner sends one.
interface Props {
  label: string;
  ratio?: string;
  tone?: number;
  image?: ImageMetadata;
  /** Above the fold: load at once instead of lazily. */
  priority?: boolean;
  sizes?: string;
  /** CSS object-position: which part of the photo stays in view when it is cropped. */
  position?: string;
}

const {
  label,
  ratio = '4 / 5',
  tone = 0,
  image,
  priority = false,
  sizes = '(min-width: 768px) 50vw, 100vw',
  position = 'center',
} = Astro.props;
const tones = [
  'from-[#efe3d6] to-[#dcc6b2]',
  'from-[#e7e4dc] to-[#cfc8b8]',
  'from-[#f1e0dc] to-[#dbbfb7]',
];
---

{image ? (
  <Image
    src={image}
    alt={label}
    widths={[400, 800, 1200]}
    quality={90}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    class="w-full object-cover"
    style={`aspect-ratio: ${ratio}; object-position: ${position}`}
  />
) : (
  <div
    class={`bg-gradient-to-br ${tones[tone % tones.length]}`}
    style={`aspect-ratio: ${ratio}`}
    role="img"
    aria-label={label}
  />
)}
